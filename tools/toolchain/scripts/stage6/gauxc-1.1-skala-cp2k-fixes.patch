+// The runtime executes on the process's current CUDA device, which is selected
+// by the host code (CP2K activates its offload-selected device before entering
+// GauXC). Use that same device for the Torch model and its features instead of
+// hard-coding cuda:0.
+inline torch::Device onedft_active_device() {
+  if (not torch::cuda::is_available()) {
+    GAUXC_GENERIC_EXCEPTION("Torch CUDA Not Available");
