GpuMetricsConfigÉõ
version: 3
metricSets:
  - version: 3
    name: General Metrics for NVIDIA TU10x (any frequency)
    alias: tu10x
    metrics:
      - name: GPC Clock Frequency
        id: gpc__cycles_elapsed
        subMetrics:
          - name: MHz
            suffix: .avg.per_second
            multiplier: 9.9999999999999995e-07
        description: The frequency of the GPC graphics clock. In NVIDIA GPU Specs this is the Boost Clock and Base Clock. In nvidia-smi this is the "gr", "graphics", "Graphics Clock".
        color: "#8BDDB4"
      - name: SYS Clock Frequency
        id: sys__cycles_elapsed
        subMetrics:
          - name: MHz
            suffix: .avg.per_second
            multiplier: 9.9999999999999995e-07
        schedulingRule: migOptional
        description: The frequency of the SYS clock. The SYS clock is the clock used for the copy engines, compute and graphics command processor, and the hardware performance monitor streaming unit.
        color: "#118E44"
      - name: GR Active
        id: gr__cycles_active
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Number of cycles the graphics/compute engine is active. The graphics and compute engine are active if there is any work in the graphics pipe or if the compute pipe is processing a dispatch.
        color: "#ED6A32"
      - name: Sync Compute in Flight
        id: HUB.TriageA.gr__dispatch_cycles_active_queue_sync
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#FE7F9C"
      - name: Async Compute in Flight
        id: HUB.TriageA.gr__dispatch_cycles_active_queue_async
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#FFD179"
      - name: Draw Started
        id: FE_A.TriageA.fe__draw_count
        subMetrics:
          - name: Workloads
            suffix: .sum
        description: Number of draw calls started
        color: "#F0F000"
      - name: Dispatch Started
        id: HUB.TriageA.gr__dispatch_count
        subMetrics:
          - name: Workloads
            suffix: .sum
        description: Number of compute dispatches/grid launches started
        color: "#00F0F0"
      - name: SM Active
        id: sm__cycles_active
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Total number of cycles the SM is active (at least 1 active warp)
        color: "#FFA5A5"
      - name: SM Issue
        id: SM.TriageA.sm__inst_executed_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: SM instruction issue rate. Each SM can issue 4 instructions/cycle (1 instruction/SMSP/cycle).
        color: "#98C4DD"
      - name: Tensor Active / FP16 Active
        id: SM.TriageA.sm__pipe_shared_cycles_active_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Cycles the tensor pipe or fp16x2 pipe is active
        color: "#B3FF70"
      - name: Vertex/Tess/Geometry Warps in Flight
        id: TPC.TriageA.tpc__warps_active_shader_vtg_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Avg
            suffix: .avg
          - name: Avg Warps per Cycle
            suffix: .avg.per_cycle_elapsed
        description: Total number of graphics vertex, tesselation, geometry, and mesh shader warps in flight
        color: "#FFA5A5"
      - name: Pixel Warps in Flight
        id: TPC.TriageA.tpc__warps_active_shader_ps_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Avg
            suffix: .avg
          - name: Avg Warps per Cycle
            suffix: .avg.per_cycle_elapsed
        description: Total number of pixel shader warps in flight
        color: "#8BDDB4"
      - name: Compute Warps in Flight
        id: TPC.TriageA.tpc__warps_active_shader_cs_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Avg
            suffix: .avg
          - name: Avg Warps per Cycle
            suffix: .avg.per_cycle_elapsed
        description: Total number of compute shader warps in flight
        color: "#FFD179"
      - name: Unallocated Warps in Active SMs
        id: TPC.TriageA.tpc__warps_inactive_sm_active_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Avg
            suffix: .avg
          - name: Avg Warps per Cycle
            suffix: .avg.per_cycle_elapsed
        description: Total number of warp slots available on active SMs
        color: "#696969"
      - name: DRAM Read Bandwidth
        id: dramc__read_throughput
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: The ratio of cycles the DRAM interface was active reading data to the elapsed cycles in the same period as a percentage
        color: "#FFA5A5"
      - name: DRAM Write Bandwidth
        id: dramc__write_throughput
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: The ratio of cycles the DRAM interface was active writing data to the elapsed cycles in the same period as a percentage
        color: "#98C4DD"
      - name: NVLink RX Requests Protocol Data
        id: nvlrx__bytes_packet_request_data_protocol
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        schedulingRule: optional
        description: Number of bytes of NVLRX request protocol data
        color: "#C79536"
      - name: NVLink RX Requests User Data
        id: nvlrx__bytes_packet_request_data_user
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        schedulingRule: optional
        description: Number of bytes of NVLRX request user data
        color: "#FFD179"
      - name: NVLink RX Responses Protocol Data
        id: nvlrx__bytes_packet_response_data_protocol
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        schedulingRule: optional
        description: Number of bytes of NVLRX response protocol data
        color: "#C25D5D"
      - name: NVLink RX Responses User Data
        id: nvlrx__bytes_packet_response_data_user
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        schedulingRule: optional
        description: Number of bytes of NVLRX response user data
        color: "#FFA5A5"
      - name: NVLink TX Requests Protocol Data
        id: nvltx__bytes_packet_request_data_protocol
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        schedulingRule: optional
        description: Number of bytes of NVLTX request protocol data
        color: "#9052BF"
      - name: NVLink TX Requests User Data
        id: nvltx__bytes_packet_request_data_user
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        schedulingRule: optional
        description: Number of bytes of NVLTX request user data
        color: "#D6A4FC"
      - name: NVLink TX Responses Protocol Data
        id: nvltx__bytes_packet_response_data_protocol
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        schedulingRule: optional
        description: Number of bytes of NVLTX response protocol data
        color: "#6999B5"
      - name: NVLink TX Responses User Data
        id: nvltx__bytes_packet_response_data_user
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        schedulingRule: optional
        description: Number of bytes of NVLTX response user data
        color: "#98C4DD"
      - name: PCIe RX Throughput
        id: PCI.TriageA.pcie__read_bytes
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        schedulingRule: migOptional
        description: Number of bytes received by GPU (includes protocol)
        color: "#FF3D00"
      - name: PCIe TX Throughput
        id: PCI.TriageA.pcie__write_bytes
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        schedulingRule: migOptional
        description: Number of bytes transmitted by GPU (includes protocol)
        color: "#00CFCF"
      - name: PCIe Read Requests to BAR1
        id: pcie__rx_requests_aperture_bar1_op_read
        subMetrics:
          - name: Requests
            suffix: .sum
        description: CPU+Peer Reads from VRAM over PCIe
        color: "#87FFFF"
      - name: PCIe Write Requests to BAR1
        id: pcie__rx_requests_aperture_bar1_op_write
        subMetrics:
          - name: Requests
            suffix: .sum
        description: CPU+Peer Writes to VRAM over PCIe
        color: "#8700FF"
    chips:
      - TU102
      - TU104
      - TU106
    counterWidth: wide
    displayRows:
      - name: <Root>
        metrics:
          - GR Active
        type: overlay
        displayHeightScale: 0.5
      - name: <Root>
        metrics:
          - NVLink RX Responses User Data
          - NVLink TX Responses User Data
          - PCIe RX Throughput
          - PCIe TX Throughput
        type: overlay
        displayHeightScale: -0.5
      - name: GPC Clock Frequency
        metrics:
          - GPC Clock Frequency
        type: overlay
      - name: SYS Clock Frequency
        metrics:
          - SYS Clock Frequency
        type: overlay
      - name: GPU Active
        metrics:
          - GR Active
        description: The graphics or compute engine is active
        type: overlay
      - name: Compute in Flight
        metrics:
          - Sync Compute in Flight
          - Async Compute in Flight
        description: Compute dispatches sent to the GPU queues that have been issued, but not yet complete
        type: overlay
      - name: Draw/Dispatch Start
        metrics:
          - Draw Started
          - Dispatch Started
        description: Draw and dispatch start times
        type: overlay
      - name: SM Active
        metrics:
          - SM Active
        type: overlay
      - name: SM Instructions
        metrics:
          - SM Issue
          - Tensor Active / FP16 Active
        type: overlay
      - name: SM Warp Occupancy
        metrics:
          - Vertex/Tess/Geometry Warps in Flight
          - Pixel Warps in Flight
          - Compute Warps in Flight
          - Unallocated Warps in Active SMs
        type: stacked
        displayHeightScale: 3
      - name: DRAM Bandwidth
        metrics:
          - DRAM Read Bandwidth
          - DRAM Write Bandwidth
        type: stacked
      - name: NVLink RX Bandwidth
        metrics:
          - NVLink RX Requests Protocol Data
          - NVLink RX Requests User Data
          - NVLink RX Responses Protocol Data
          - NVLink RX Responses User Data
        type: stacked
      - name: NVLink TX Bandwidth
        metrics:
          - NVLink TX Requests Protocol Data
          - NVLink TX Requests User Data
          - NVLink TX Responses Protocol Data
          - NVLink TX Responses User Data
        type: stacked
      - name: PCIe Bandwidth
        metrics:
          - PCIe RX Throughput
          - PCIe TX Throughput
        type: overlay
      - name: PCIe Read Requests to BAR1
        metrics:
          - PCIe Read Requests to BAR1
        type: overlay
      - name: PCIe Write Requests to BAR1
        metrics:
          - PCIe Write Requests to BAR1
        type: overlay
  - version: 3
    name: General Metrics for NVIDIA TU11x (any frequency)
    alias: tu11x
    metrics:
      - name: GPC Clock Frequency
        id: gpc__cycles_elapsed
        subMetrics:
          - name: MHz
            suffix: .avg.per_second
            multiplier: 9.9999999999999995e-07
        description: The frequency of the GPC graphics clock. In NVIDIA GPU Specs this is the Boost Clock and Base Clock. In nvidia-smi this is the "gr", "graphics", "Graphics Clock".
        color: "#8BDDB4"
      - name: SYS Clock Frequency
        id: sys__cycles_elapsed
        subMetrics:
          - name: MHz
            suffix: .avg.per_second
            multiplier: 9.9999999999999995e-07
        schedulingRule: migOptional
        description: The frequency of the SYS clock. The SYS clock is the clock used for the copy engines, compute and graphics command processor, and the hardware performance monitor streaming unit.
        color: "#118E44"
      - name: GR Active
        id: gr__cycles_active
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Number of cycles the graphics/compute engine is active. The graphics and compute engine are active if there is any work in the graphics pipe or if the compute pipe is processing a dispatch.
        color: "#ED6A32"
      - name: Sync Compute in Flight
        id: HUB.TriageA.gr__dispatch_cycles_active_queue_sync
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#FE7F9C"
      - name: Async Compute in Flight
        id: HUB.TriageA.gr__dispatch_cycles_active_queue_async
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#FFD179"
      - name: Draw Started
        id: FE_A.TriageA.fe__draw_count
        subMetrics:
          - name: Workloads
            suffix: .sum
        description: Number of draw calls started
        color: "#F0F000"
      - name: Dispatch Started
        id: HUB.TriageA.gr__dispatch_count
        subMetrics:
          - name: Workloads
            suffix: .sum
        description: Number of compute dispatches/grid launches started
        color: "#00F0F0"
      - name: SM Active
        id: sm__cycles_active
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Total number of cycles the SM is active (at least 1 active warp)
        color: "#FFA5A5"
      - name: SM Issue
        id: SM.TriageA.sm__inst_executed_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: SM instruction issue rate. Each SM can issue 4 instructions/cycle (1 instruction/SMSP/cycle).
        color: "#98C4DD"
      - name: Vertex/Tess/Geometry Warps in Flight
        id: TPC.TriageA.tpc__warps_active_shader_vtg_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Avg
            suffix: .avg
          - name: Avg Warps per Cycle
            suffix: .avg.per_cycle_elapsed
        description: Total number of graphics vertex, tesselation, geometry, and mesh shader warps in flight
        color: "#FFA5A5"
      - name: Pixel Warps in Flight
        id: TPC.TriageA.tpc__warps_active_shader_ps_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Avg
            suffix: .avg
          - name: Avg Warps per Cycle
            suffix: .avg.per_cycle_elapsed
        description: Total number of pixel shader warps in flight
        color: "#8BDDB4"
      - name: Compute Warps in Flight
        id: TPC.TriageA.tpc__warps_active_shader_cs_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Avg
            suffix: .avg
          - name: Avg Warps per Cycle
            suffix: .avg.per_cycle_elapsed
        description: Total number of compute shader warps in flight
        color: "#FFD179"
      - name: Unallocated Warps in Active SMs
        id: TPC.TriageA.tpc__warps_inactive_sm_active_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Avg
            suffix: .avg
          - name: Avg Warps per Cycle
            suffix: .avg.per_cycle_elapsed
        description: Total number of warp slots available on active SMs
        color: "#696969"
      - name: DRAM Read Bandwidth
        id: dramc__read_throughput
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: The ratio of cycles the DRAM interface was active reading data to the elapsed cycles in the same period as a percentage
        color: "#FFA5A5"
      - name: DRAM Write Bandwidth
        id: dramc__write_throughput
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: The ratio of cycles the DRAM interface was active writing data to the elapsed cycles in the same period as a percentage
        color: "#98C4DD"
      - name: PCIe RX Throughput
        id: PCI.TriageA.pcie__read_bytes
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        schedulingRule: migOptional
        description: Number of bytes received by GPU (includes protocol)
        color: "#FF3D00"
      - name: PCIe TX Throughput
        id: PCI.TriageA.pcie__write_bytes
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        schedulingRule: migOptional
        description: Number of bytes transmitted by GPU (includes protocol)
        color: "#00CFCF"
      - name: PCIe Read Requests to BAR1
        id: pcie__rx_requests_aperture_bar1_op_read
        subMetrics:
          - name: Requests
            suffix: .sum
        description: CPU+Peer Reads from VRAM over PCIe
        color: "#87FFFF"
      - name: PCIe Write Requests to BAR1
        id: pcie__rx_requests_aperture_bar1_op_write
        subMetrics:
          - name: Requests
            suffix: .sum
        description: CPU+Peer Writes to VRAM over PCIe
        color: "#8700FF"
    chips:
      - TU116
      - TU117
    counterWidth: wide
    displayRows:
      - name: <Root>
        metrics:
          - GR Active
        type: overlay
        displayHeightScale: 0.5
      - name: <Root>
        metrics:
          - PCIe RX Throughput
          - PCIe TX Throughput
        type: overlay
        displayHeightScale: -0.5
      - name: GPC Clock Frequency
        metrics:
          - GPC Clock Frequency
        type: overlay
      - name: SYS Clock Frequency
        metrics:
          - SYS Clock Frequency
        type: overlay
      - name: GPU Active
        metrics:
          - GR Active
        description: The graphics or compute engine is active
        type: overlay
      - name: Compute in Flight
        metrics:
          - Sync Compute in Flight
          - Async Compute in Flight
        description: Compute dispatches sent to the GPU queues that have been issued, but not yet complete
        type: overlay
      - name: Draw/Dispatch Start
        metrics:
          - Draw Started
          - Dispatch Started
        description: Draw and dispatch start times
        type: overlay
      - name: SM Active
        metrics:
          - SM Active
        type: overlay
      - name: SM Instructions
        metrics:
          - SM Issue
        type: overlay
      - name: SM Warp Occupancy
        metrics:
          - Vertex/Tess/Geometry Warps in Flight
          - Pixel Warps in Flight
          - Compute Warps in Flight
          - Unallocated Warps in Active SMs
        type: stacked
        displayHeightScale: 3
      - name: DRAM Bandwidth
        metrics:
          - DRAM Read Bandwidth
          - DRAM Write Bandwidth
        type: stacked
      - name: PCIe Bandwidth
        metrics:
          - PCIe RX Throughput
          - PCIe TX Throughput
        type: overlay
      - name: PCIe Read Requests to BAR1
        metrics:
          - PCIe Read Requests to BAR1
        type: overlay
      - name: PCIe Write Requests to BAR1
        metrics:
          - PCIe Write Requests to BAR1
        type: overlay
  - version: 3
    name: General Metrics for NVIDIA GA100 (any frequency)
    alias: ga100
    metrics:
      - name: GPC Clock Frequency
        id: gpc__cycles_elapsed
        subMetrics:
          - name: MHz
            suffix: .avg.per_second
            multiplier: 9.9999999999999995e-07
        description: The frequency of the GPC graphics clock. In NVIDIA GPU Specs this is the Boost Clock and Base Clock. In nvidia-smi this is the "gr", "graphics", "Graphics Clock".
        color: "#8BDDB4"
      - name: SYS Clock Frequency
        id: sys__cycles_elapsed
        subMetrics:
          - name: MHz
            suffix: .avg.per_second
            multiplier: 9.9999999999999995e-07
        schedulingRule: migOptional
        description: The frequency of the SYS clock. The SYS clock is the clock used for the copy engines, compute and graphics command processor, and the hardware performance monitor streaming unit.
        color: "#118E44"
      - name: GR Active
        id: gr__cycles_active
        subMetrics:
          - name: Throughput %
            suffix: .sum.pct_of_peak_sustained_elapsed
        description: Number of cycles the graphics/compute engine is active. The graphics and compute engine are active if there is any work in the graphics pipe or if the compute pipe is processing a dispatch.
        color: "#ED6A32"
      - name: SM Active
        id: sm__cycles_active
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Total number of cycles the SM is active (at least 1 active warp)
        color: "#FFA5A5"
      - name: SM Issue
        id: sm__inst_executed_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: SM instruction issue rate. Each SM can issue 4 instructions/cycle (1 instruction/SMSP/cycle).
        color: "#98C4DD"
      - name: Tensor Active
        id: sm__pipe_tensor_cycles_active_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Cycles the tensor pipe is active
        color: "#B3FF70"
      - name: Vertex/Tess/Geometry Warps in Flight
        id: tpc__warps_active_shader_vtg_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Avg
            suffix: .avg
          - name: Avg Warps per Cycle
            suffix: .avg.per_cycle_elapsed
        description: Total number of graphics vertex, tesselation, geometry, and mesh shader warps in flight
        color: "#FFA5A5"
      - name: Pixel Warps in Flight
        id: tpc__warps_active_shader_ps_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Avg
            suffix: .avg
          - name: Avg Warps per Cycle
            suffix: .avg.per_cycle_elapsed
        description: Total number of pixel shader warps in flight
        color: "#8BDDB4"
      - name: Compute Warps in Flight
        id: tpc__warps_active_shader_cs_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Avg
            suffix: .avg
          - name: Avg Warps per Cycle
            suffix: .avg.per_cycle_elapsed
        description: Total number of compute shader warps in flight
        color: "#FFD179"
      - name: Unallocated Warps in Active SMs
        id: tpc__warps_inactive_sm_active_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Avg
            suffix: .avg
          - name: Avg Warps per Cycle
            suffix: .avg.per_cycle_elapsed
        description: Total number of warp slots available on active SMs
        color: "#696969"
      - name: DRAM Read Bandwidth
        id: dram__read_throughput
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: The ratio of cycles the DRAM interface was active reading data to the elapsed cycles in the same period as a percentage
        color: "#FFA5A5"
      - name: DRAM Write Bandwidth
        id: dram__write_throughput
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: The ratio of cycles the DRAM interface was active writing data to the elapsed cycles in the same period as a percentage
        color: "#98C4DD"
      - name: NVLink RX Requests Protocol Data
        id: nvlrx__bytes_packet_request_data_protocol
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        schedulingRule: optional
        description: Number of bytes of NVLRX request protocol data
        color: "#C79536"
      - name: NVLink RX Requests User Data
        id: nvlrx__bytes_packet_request_data_user
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        schedulingRule: optional
        description: Number of bytes of NVLRX request user data
        color: "#FFD179"
      - name: NVLink RX Responses Protocol Data
        id: nvlrx__bytes_packet_response_data_protocol
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        schedulingRule: optional
        description: Number of bytes of NVLRX response protocol data
        color: "#C25D5D"
      - name: NVLink RX Responses User Data
        id: nvlrx__bytes_packet_response_data_user
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        schedulingRule: optional
        description: Number of bytes of NVLRX response user data
        color: "#FFA5A5"
      - name: NVLink TX Requests Protocol Data
        id: nvltx__bytes_packet_request_data_protocol
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        schedulingRule: optional
        description: Number of bytes of NVLTX request protocol data
        color: "#9052BF"
      - name: NVLink TX Requests User Data
        id: nvltx__bytes_packet_request_data_user
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        schedulingRule: optional
        description: Number of bytes of NVLTX request user data
        color: "#D6A4FC"
      - name: NVLink TX Responses Protocol Data
        id: nvltx__bytes_packet_response_data_protocol
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        schedulingRule: optional
        description: Number of bytes of NVLTX response protocol data
        color: "#6999B5"
      - name: NVLink TX Responses User Data
        id: nvltx__bytes_packet_response_data_user
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        schedulingRule: optional
        description: Number of bytes of NVLTX response user data
        color: "#98C4DD"
      - name: PCIe RX Throughput
        id: pcie__read_bytes
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        schedulingRule: migOptional
        description: Number of bytes received by GPU (includes protocol)
        color: "#FF3D00"
      - name: PCIe TX Throughput
        id: pcie__write_bytes
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        schedulingRule: migOptional
        description: Number of bytes transmitted by GPU (includes protocol)
        color: "#00CFCF"
    chips:
      - GA100
    counterWidth: wide
    displayRows:
      - name: <Root>
        metrics:
          - GR Active
        type: overlay
        displayHeightScale: 0.5
      - name: <Root>
        metrics:
          - NVLink RX Responses User Data
          - NVLink TX Responses User Data
          - PCIe RX Throughput
          - PCIe TX Throughput
        type: overlay
        displayHeightScale: -0.5
      - name: GPC Clock Frequency
        metrics:
          - GPC Clock Frequency
        type: overlay
      - name: SYS Clock Frequency
        metrics:
          - SYS Clock Frequency
        type: overlay
      - name: GPU Active
        metrics:
          - GR Active
