            suffix: .sum
        color: "#AA1111"
      - name: Subchannel Switch Async
        id: FE_B.TriageSCG.fe__output_ops_cmd_subchsw_queue_async
        subMetrics:
          - name: Commands
            suffix: .sum
        color: "#1111AA"
      - name: Pixel Shader Barriers
