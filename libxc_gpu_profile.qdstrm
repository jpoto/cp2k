        schedulingRule: migOptional
        description: Number of bytes transmitted by GPU (includes protocol)
        color: "#00CFCF"
    chips:
      - GH100
    counterWidth: wide
    displayRows:
      - name: <Root>
        metrics:
          - GR Active
        type: overlay
        displayHeightScale: 0.5
      - name: <Root>
        metrics:
          - NVLink RX Responses User Data
