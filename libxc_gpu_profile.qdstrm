          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#D13341"
      - name: L1 Throughput
        id: SM.TriageA.l1tex__throughput
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#FFC425"
