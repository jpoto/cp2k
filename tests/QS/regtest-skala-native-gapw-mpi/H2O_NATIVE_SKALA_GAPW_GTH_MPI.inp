&GLOBAL
  PRINT_LEVEL LOW
  PROJECT_NAME H2O_NATIVE_SKALA_GAPW_GTH_MPI
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME GTH_BASIS_SETS
    MULTIPLICITY 1
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    UKS FALSE
    &MGRID
      CUTOFF 80
      REL_CUTOFF 20
    &END MGRID
    &POISSON
      PERIODIC XYZ
    &END POISSON
    &QS
      EPS_DEFAULT 1.0E-8
      EXTRAPOLATION USE_PREV_WF
      METHOD GAPW
    &END QS
    &SCF
      EPS_SCF 1.0E-5
      IGNORE_CONVERGENCE_FAILURE T
      MAX_SCF 1
      SCF_GUESS ATOMIC
      &DIAGONALIZATION
      &END DIAGONALIZATION
    &END SCF
    &XC
      &XC_FUNCTIONAL
        &SKALA_NATIVE
          ATOM_PARTITION SMOOTH
          DIAGNOSTICS F
          LAYOUT COMMON_GRID
          MODEL SKALA
          PSEUDOPOTENTIAL_GAPW_REPRESENTATION PAW_ONE_CENTER
        &END SKALA_NATIVE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 6.0 6.0 6.0
      PERIODIC XYZ
    &END CELL
    &COORD
      O 3.000000 3.000000 3.000000
      H 3.000000 3.758602 3.504284
      H 3.000000 2.241398 3.504284
    &END COORD
    &KIND O
      BASIS_SET DZVP-GTH
      HARD_EXP_RADIUS 1.0
      LEBEDEV_GRID 50
      POTENTIAL GTH-PBE-q6
      RADIAL_GRID 50
    &END KIND
    &KIND H
      BASIS_SET DZVP-GTH
      HARD_EXP_RADIUS 1.0
      LEBEDEV_GRID 50
      POTENTIAL GTH-PBE-q1
      RADIAL_GRID 50
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
