&GLOBAL
  PRINT_LEVEL LOW
  PROJECT CH2O
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  &DFT
    &POISSON
      PERIODIC XYZ
      POISSON_SOLVER PERIODIC
      &EWALD
        ALPHA 0.6
      &END EWALD
    &END POISSON
    &PRINT
      &EEQ_CHARGES ON
      &END EEQ_CHARGES
    &END PRINT
    &QS
      METHOD xTB
      &XTB
        GFN_TYPE 1
        STO_FLEX T
        KLOPMAN_OHNO_EWALD
        VDW_POTENTIAL DFTD3
        &PARAMETER
          DISPERSION_RADIUS 25
        &END PARAMETER
      &END XTB
    &END QS
    &SCF
      EPS_SCF 1.E-8
      MAX_SCF 50
      SCF_GUESS ATOMIC
    &END SCF
  &END DFT
  &SUBSYS
    &CELL
      ABC 10.0 10.0 10.0
    &END CELL
    &COORD
      O     0.051368    0.000000    0.000000
      C     1.278612    0.000000    0.000000
      H     1.870460    0.939607    0.000000
      H     1.870460   -0.939607    0.000000
    &END COORD
  &END SUBSYS
&END FORCE_EVAL
